# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# Fastest way to populate: `vercel link` then `vercel env pull .env.local`.

# --- App / Supabase (required for local dev) ---
# Public keys — safe to expose to the browser. Enough to run the front end
# and anything that reads/writes through the anon (RLS-constrained) client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Only needed to run server routes that act
# without a user session (inbound email, notifications) locally. Server-only,
# never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email / Microsoft Graph (Help Desk) ---
# Only needed if exercising the Graph webhook / outbound email routes locally.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_CLIENT_STATE=
IT_MAILBOX=
PRICEUPDATE_MAILBOX=
APP_BASE_URL=https://www.prstech.app
HELPDESK_INBOUND_TOKEN=
CRON_SECRET=

# Optional Power Automate outbound fallback.
POWER_AUTOMATE_NOTIFY_URL=
